<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>StudentRunner</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <DebugType>none</DebugType>
    <CompressionEnabled>false</CompressionEnabled>
    <NuGetAudit>false</NuGetAudit>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="InputRoutes.cs" />
    <Using Remove="Microsoft.Extensions.Configuration;Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <EmbeddedResource Include="obj/refs-$(TargetFramework).zip" LogicalName="StudentRunner.refs.zip" />
  </ItemGroup>
</Project>
