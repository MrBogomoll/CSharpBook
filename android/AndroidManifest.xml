<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="ru.csharpbook.reader" android:versionCode="5" android:versionName="0.2.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
